# 飞书开放平台配置 (https://open.feishu.cn/)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格配置
# 飞书表格链接格式如: https://xx.feishu.cn/base/bascnXXXXXXXXXXXXXX?table=tblXXXXXXXXXX
# 其中 bascnXXXXXXXXXXXXXX 即为 FEISHU_APP_TOKEN
# 其中 tblXXXXXXXXXX 即为 FEISHU_TABLE_ID
FEISHU_APP_TOKEN=bascnXXXXXXXXXXXXXX
FEISHU_TABLE_ID=tblXXXXXXXXXX

# Boss直聘自动化配置
# 搜索关键词，默认为 "AI产品经理"
BOSS_SEARCH_KEYWORDS=AI产品经理

# 每天最大自动投递/打招呼数量限制，防止风控封号
MAX_DAILY_APPLIES=30
